# Python
__pycache__/
*.pyc
.venv/
venv/

# Secrets -- real values live only in .env locally, never committed.
# .env.example is the committed template.
.env

# The real database and any personal raw exports -- gitignored for now
# since they'll contain your actual listening/purchase history. We'll
# revisit this deliberately once we're ready to publish (the whole plan
# is to ship music.sqlite to the static site eventually, but that's an
# explicit decision, not an accident of `git add .`).
data/music.sqlite
data/raw/*
!data/raw/.gitkeep
!data/raw/sample_discogs_export.csv
imports/

# Pre-refresh snapshots the maintenance UI takes so a rejected refresh can
# restore data/music.sqlite -- deleted automatically once you accept or
# reject, but ignored as a backstop in case one is ever left behind.
data/.refresh_backups/

# Pre-merge snapshots the artist/album/song maintenance UI takes before
# any merge (reassigning FKs and deleting the absorbed row) -- kept
# indefinitely as a manual undo path, so ignored rather than cleaned up
# automatically.
data/.merge_backups/

# site/public/music.sqlite (the slim public build) is INTENTIONALLY
# tracked, not ignored -- it's what GitHub Pages serves. That was a
# deliberate "ready to publish" decision, not a default; re-run
# etl/build_public_db.py and commit the result whenever the underlying
# data/music.sqlite changes and you want the published site to reflect it.

# Node (frontend, once site/ has one)
node_modules/
site/dist/
site/build/

# Editors / OS
.DS_Store
