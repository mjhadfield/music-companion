# Copy this file to .env (gitignored) and fill in real values.
# Never commit the real .env.

LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
LASTFM_USERNAME=

SETLISTFM_API_KEY=
SETLISTFM_USERNAME=

SPOTIFY_CLIENT_ID=

# Discogs personal access token (discogs.com > Settings > Developers > Generate new token): lets the
# maintenance Refresh read your collection live (instead of a CSV export) and raises the API limit to 60/min.
DISCOGS_TOKEN=
